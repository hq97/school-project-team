dist/
build/
target/
out/
*.class
*.jar
!gradle-wrapper.jar

# IDE
.idea/
.vscode/
*.iml
.settings/
.classpath
.project

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 项目本地数据（WorkBuddy 记忆/工作区数据，不进公开仓库）
.workbuddy/

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 前端构建/类型缓存（Vite / TypeScript 增量）
.vite/
*.tsbuildinfo

# Python（E2E 测试脚本 scripts/flow_e2e.py）
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# 测试覆盖率
coverage/
.coverage
htmlcov/

# JVM 崩溃日志
hs_err_pid*

# 临时退出码/验证残留（工具运行时的 exit 记录）
_*.txt
