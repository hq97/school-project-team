# 校务平台服务端环境变量基线（复制给新校时只改此文件，不动代码）
# 说明：本文件是模板；实际值写在同目录 .env（不入库，由版本控制专家在 .gitignore 排除）

# 数据库（PostgreSQL 16）：本地验证默认指向 5433，避免与本机已有 5432 实例冲突
DATABASE_URL="postgresql://postgres:school@localhost:5433/school?schema=public"

# Redis（C10 调度 / BullMQ 用；骨架阶段未启用，预留）
REDIS_URL="redis://localhost:6379/0"

# JWT 密钥：生产必须注入（缺失时启动期 process.exit(1)）；开发兜底 dev-secret 仅限本地
JWT_SECRET="dev-only-secret-0123456789abcdef0123456789abcdef"

# 服务端口
PORT=3000

# 环境：production 时强制校验 JWT_SECRET
NODE_ENV=development
